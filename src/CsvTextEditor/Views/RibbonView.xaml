<catel:UserControl x:Class="CsvTextEditor.Views.RibbonView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:CsvTextEditor.Views"
                   xmlns:catel="http://schemas.catelproject.com"
                   xmlns:fluent="urn:fluent-ribbon"
                   xmlns:orccontrols="http://schemas.wildgums.com/orc/controls"
                   xmlns:orchestra="http://schemas.wildgums.com/orchestra"
                   xmlns:csvTextEditor="clr-namespace:CsvTextEditor"
                   xmlns:orctheming="http://schemas.wildgums.com/orc/theming"
                   mc:Ignorable="d"
                   d:DesignHeight="300"
                   d:DesignWidth="300">

    <fluent:Ribbon x:Name="ribbon"
                   IsQuickAccessToolBarVisible="False"
                   CanCustomizeRibbon="False"
                   AutomaticStateManagement="False">
        <fluent:Ribbon.Menu>
            <fluent:Backstage Header="{catel:LanguageBinding Ribbon_File}">
                <fluent:BackstageTabControl>
                    <fluent:BackstageTabItem Header="{catel:LanguageBinding Ribbon_Open}">
                        <local:OpenFileView />
                    </fluent:BackstageTabItem>

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Save}"
                                   Command="{catel:CommandManagerBinding File.Save}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_SaveAs}"
                                   Command="{catel:CommandManagerBinding File.SaveAs}" />
                </fluent:BackstageTabControl>
            </fluent:Backstage>
        </fluent:Ribbon.Menu>

        <fluent:Ribbon.Tabs>
            <fluent:RibbonTabItem Header="{catel:LanguageBinding Ribbon_View}">
                <fluent:RibbonGroupBox Header="{catel:LanguageBinding Ribbon_FileGroup}">

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Save}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Save}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding File.Save}" />


                    <fluent:SplitButton Header="{catel:LanguageBinding Ribbon_OpenInEditor}"
                                        LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Edit}, FontFamily=FontAwesome}"
                                        Command="{catel:CommandManagerBinding File.OpenInTextEditor}"
                                        IsEnabled="{Binding IsActiveProjectExists}">
                        <fluent:Gallery ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <fluent:Button Header="{catel:LanguageBinding Ribbon_Excel}"
                                           LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.FileExcelO}, FontFamily=FontAwesome}"
                                           Command="{catel:CommandManagerBinding File.OpenInExcel}"/>
                        </fluent:Gallery>
                    </fluent:SplitButton>
                </fluent:RibbonGroupBox>

                <fluent:RibbonGroupBox Header="{catel:LanguageBinding Ribbon_Edit}">
                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Copy}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Copy}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.Copy}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Cut}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Cut}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.Cut}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Paste}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Paste}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.Paste}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Undo}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.MailReply}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.Undo}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_Redo}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.MailForward}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.Redo}" />

                    <fluent:Button x:Name="FindAndReplaceButton" Header="{catel:LanguageBinding Ribbon_FindReplace}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Search}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.FindReplace}" />

                    <fluent:Button Header="{catel:LanguageBinding Ribbon_QuoteColumn}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.QuoteLeft}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Edit.QuoteColumn}" />

                    <fluent:SplitButton Header="{catel:LanguageBinding Ribbon_QuickFormat}" LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.AlignJustify}, FontFamily=FontAwesome}" IsEnabled="{Binding ElementName=FindAndReplaceButton, Path=IsEnabled}">
                        <fluent:MenuItem Header="{catel:LanguageBinding Ribbon_RemoveBlankLines}" Icon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Remove}}" Command="{catel:CommandManagerBinding Edit.RemoveBlankLines}" />
                        <fluent:MenuItem Header="{catel:LanguageBinding Ribbon_RemoveDuplicateLines}" Icon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Remove}}" Command="{catel:CommandManagerBinding Edit.RemoveDuplicateLines}" />
                        <fluent:MenuItem Header="{catel:LanguageBinding Ribbon_TrimWhitespaces}" Icon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.AlignJustify}}" Command="{catel:CommandManagerBinding Edit.TrimWhitespaces}" />
                    </fluent:SplitButton>
                </fluent:RibbonGroupBox>

                <fluent:RibbonGroupBox Header="{catel:LanguageBinding Ribbon_Settings}">
                    <fluent:Button Header="{catel:LanguageBinding Ribbon_SettingsButton}"
                                   LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.Cog}, FontFamily=FontAwesome}"
                                   Command="{catel:CommandManagerBinding Settings.General}" />

                    <fluent:SplitButton Header="{catel:LanguageBinding Ribbon_Shortcuts}"
                                        LargeIcon="{orctheming:FontImage {x:Static csvTextEditor:FontAwesome.KeyboardO}, FontFamily=FontAwesome}"
                                        Command="{Binding ShowKeyboardMappings}" >
                        <orchestra:KeyboardMappingsOverviewView />
                    </fluent:SplitButton>
                </fluent:RibbonGroupBox>

                <fluent:RibbonGroupBox Header="{catel:LanguageBinding Ribbon_Highlight}">
                    <local:FindView Margin="2,10,2,2"/>
                </fluent:RibbonGroupBox>

                <fluent:RibbonGroupBox Header="{catel:LanguageBinding Ribbon_Statistic}"
                                       Visibility="{Binding Project, Converter={catel:ReferenceToCollapsingVisibilityConverter}}">
                    <local:ProjectStatisticView Margin="2,10,2,2"/>
                </fluent:RibbonGroupBox>

            </fluent:RibbonTabItem>
        </fluent:Ribbon.Tabs>
    </fluent:Ribbon>
</catel:UserControl>
